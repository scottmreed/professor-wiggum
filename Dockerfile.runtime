# Mechanism Runtime — product-facing, research surfaces not mounted
# (Observatory PRD §21). Build from the repo root:
#   docker build -f Dockerfile.runtime --build-arg GIT_SHA=$(git rev-parse HEAD) -t mechanism-runtime .
# Run:
#   docker run -e MECHANISTIC_RUNTIME_TOKEN=... -e OPENROUTER_API_KEY=... -p 8010:8010 mechanism-runtime
FROM python:3.11-slim

ARG GIT_SHA=""
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    MECHANISTIC_RUNTIME_GIT_SHA=${GIT_SHA} \
    MECHANISTIC_DATA_DIR=/data

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libxrender1 libxext6 && rm -rf /var/lib/apt/lists/*
COPY requirements.txt pyproject.toml ./
RUN pip install --no-cache-dir -r requirements.txt
COPY mechanistic_agent ./mechanistic_agent
COPY skills ./skills
COPY harness_versions ./harness_versions
COPY training_data ./training_data
COPY main.py ./
# .dockerignore keeps the leaderboard holdout, local data, traces and secrets out of the context.
RUN pip install --no-cache-dir -e . --no-deps && mkdir -p /data
EXPOSE 8010
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8010/healthz').status==200 else 1)"
CMD ["uvicorn", "mechanistic_agent.api.runtime_app:create_runtime_app", "--factory", "--host", "0.0.0.0", "--port", "8010"]
