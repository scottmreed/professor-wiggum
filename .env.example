# Required to use OpenAI models (gpt-4o, o3, etc.)
OPENAI_API_KEY=

# Required to use OpenRouter (provides access to Claude, Gemini, Llama, and others)
OPENROUTER_API_KEY=

# Required to use Google Gemini models directly
GOOGLE_API_KEY=
# GEMINI_API_KEY= is also accepted as an alternative to GOOGLE_API_KEY.

# At least one key must be set for any LLM call to succeed.
# Only the key for the provider you use is required — you do not need all three.
# Example: to run Claude models via OpenRouter, only OPENROUTER_API_KEY is needed.

# Optional: prompt character caps for mechanism intermediates.
# These control how much context we send to each model before we start compacting.
# Values below are safe starting points; tune up/down based on cost and provider limits.

# Default cap for non-OpenRouter, non-gpt-4o models (e.g. local OpenAI models).
# ~600k tokens of input at ~4 chars/token.
# MECHANISTIC_PROMPT_CHAR_CAP=2400000

# Cap for OpenRouter Anthropic models (e.g. anthropic/claude-opus-4.6).
# ~300k tokens of input at ~4 chars/token.
# MECHANISTIC_OPENROUTER_PROMPT_CHAR_CAP=1200000

# Cap for large-context GPT-5.4 models.
# ~600k tokens of input at ~4 chars/token.
# MECHANISTIC_GPT54_PROMPT_CHAR_CAP=2400000

# Cap for gpt-4o / gpt-4o-mini (kept smaller to control cost).
# ~10k tokens of input at ~4 chars/token.
# MECHANISTIC_GPT4O_PROMPT_CHAR_CAP=40000
