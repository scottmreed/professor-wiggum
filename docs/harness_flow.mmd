flowchart TD
  balance_analysis["Check Atom Balance"]
  functional_groups["Identify Functional Groups"]
  ph_recommendation["Recommend pH"]
  initial_conditions["Assess Reaction Conditions"]
  missing_reagents["Predict Missing Reagents"]
  atom_mapping["Map Atoms Between Reactants/Products"]
  reaction_type_mapping["Map To Reaction Type"]
  mechanism_step_proposal["Propose Mechanism Step"]
  mechanism_synthesis["Validate Mechanism Step"]
  bond_electron_validation["Check Bond/Electron Conservation"]
  atom_balance_validation["Check Step Atom Balance"]
  state_progress_validation["Check State Changed"]
  retry_gate["Retry or Continue?"]
  backtrack_gate["Backtrack?"]
  completion_check["Target Products Reached?"]
  reflection["Collect Validation Warnings"]
  step_atom_mapping["Map Atoms for Step"]
  run_failed["Run Failed"]
  run_complete["Run Complete"]
  balance_analysis --> functional_groups
  functional_groups --> ph_recommendation
  ph_recommendation --> initial_conditions
  initial_conditions --> missing_reagents
  missing_reagents --> atom_mapping
  atom_mapping --> reaction_type_mapping
  reaction_type_mapping --> mechanism_step_proposal
  mechanism_step_proposal --> mechanism_synthesis
  mechanism_synthesis --> bond_electron_validation
  bond_electron_validation --> atom_balance_validation
  atom_balance_validation --> state_progress_validation
  state_progress_validation --> retry_gate
  completion_check -->|no| reflection
  reflection --> step_atom_mapping
  step_atom_mapping -->|loop| mechanism_step_proposal
  retry_gate -->|valid| completion_check
  retry_gate -->|retry| mechanism_synthesis
  retry_gate -->|repropose| mechanism_step_proposal
  retry_gate -->|all_failed| backtrack_gate
  backtrack_gate -->|revert_to_branch| mechanism_step_proposal
  backtrack_gate -->|no_branches| run_failed
  completion_check -->|yes| run_complete
  style balance_analysis fill:#e7f4ea,stroke:#2f7d3b,stroke-width:1px,opacity:0.9
  style functional_groups fill:#e7f4ea,stroke:#2f7d3b,stroke-width:1px,opacity:0.9
  style ph_recommendation fill:#e7f4ea,stroke:#2f7d3b,stroke-width:1px,opacity:0.9
  style initial_conditions fill:#fff2d8,stroke:#c26b00,stroke-width:1px,opacity:0.9
  style missing_reagents fill:#fff2d8,stroke:#c26b00,stroke-width:1px,opacity:0.9
  style atom_mapping fill:#fff2d8,stroke:#c26b00,stroke-width:1px,opacity:0.9
  style reaction_type_mapping fill:#fff2d8,stroke:#c26b00,stroke-width:1px,opacity:0.9
  style mechanism_step_proposal fill:#fff2d8,stroke:#c26b00,stroke-width:1px,opacity:0.9
  style mechanism_synthesis fill:#e7f4ea,stroke:#2f7d3b,stroke-width:1px,opacity:0.9
  style bond_electron_validation fill:#e7f4ea,stroke:#2f7d3b,stroke-width:1px,opacity:0.9
  style atom_balance_validation fill:#e7f4ea,stroke:#2f7d3b,stroke-width:1px,opacity:0.9
  style state_progress_validation fill:#e7f4ea,stroke:#2f7d3b,stroke-width:1px,opacity:0.9
  style retry_gate fill:#e8eefb,stroke:#3355aa,stroke-width:1px,opacity:0.9
  style backtrack_gate fill:#e8eefb,stroke:#3355aa,stroke-width:1px,opacity:0.9
  style completion_check fill:#e8eefb,stroke:#3355aa,stroke-width:1px,opacity:0.9
