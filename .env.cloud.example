# Cloud deployment — copy to .env or set in your platform's env UI.
# Only set the keys for providers you actually use.

# --- Required: at least one LLM provider (pick one path) ---

# OpenAI models (gpt-4o, gpt-5.x, o-series)
OPENAI_API_KEY=

# OpenRouter (Claude, OLMo, many others via anthropic/claude-opus-4.6 style ids)
OPENROUTER_API_KEY=

# Direct Anthropic (also used as OpenRouter fallback when OPENROUTER_API_KEY unset)
ANTHROPIC_API_KEY=

# Google Gemini (GOOGLE_API_KEY or GEMINI_API_KEY)
GOOGLE_API_KEY=

# --- Server (cloud platforms usually set PORT) ---

MECHANISTIC_HOST=0.0.0.0
MECHANISTIC_PORT=8010
# PORT=8010

# --- Persistent data (strongly recommended in cloud) ---
# Mount a volume at this path so runs/traces/DB survive redeploys.
MECHANISTIC_DATA_DIR=/data/wiggum-data
# WIGGUM_DATA_DIR=/data/wiggum-data

# Repo root override (only if cwd differs from install path)
# MECHANISTIC_PROJECT_ROOT=/app

# --- Production hardening (recommended for public deployments) ---

# Disable git/subprocess ops exposed by some API routes
MECH_ENABLE_GIT_OPS=false
MECH_ENABLE_SUBPROCESS_OPS=false

# CORS: comma-separated exact origins if UI is on another domain
# MECH_CORS_ORIGINS=https://your-frontend.example.com

# --- Chemistry backend ---

# auto | python | rdkit_cli (rdkit_cli needs npm install + node in PATH)
MECHANISTIC_CHEMISTRY_BACKEND=auto
# MECHANISTIC_RDKIT_CLI_COMMAND=rdkit-agent
# MECHANISTIC_RDKIT_CLI_TIMEOUT_SECONDS=5

# --- Keyless agent bridge (no API key; external responder required) ---
# MECHANISTIC_ACTIVE_MODEL=agent-bridge
# MECHANISTIC_AGENT_BRIDGE_DIR=/data/agent_bridge
# MECHANISTIC_AGENT_BRIDGE_TIMEOUT=1800
# MECHANISTIC_AGENT_BRIDGE_POLL_SECONDS=0.2
# MECHANISTIC_AGENT_BRIDGE_DECLARED_MODEL=your-model-label
# MECHANISTIC_AGENT_BRIDGE_RESPONDER_KIND=orchestrator_subagents
# MECHANISTIC_AGENT_BRIDGE_SAW_GROUND_TRUTH=false

# --- Optional tuning (defaults are fine for most cloud runs) ---

# MECHANISTIC_AUTO_APPROVE=1
# MECHANISTIC_FUNCTIONAL_GROUPS_ENABLED=1
# MECHANISTIC_ACTIVE_MODEL=anthropic/claude-opus-4.6
# MECHANISTIC_PROMPT_CHAR_CAP=60000
# MECHANISTIC_OPENROUTER_PROMPT_CHAR_CAP=42000
# MECHANISTIC_GPT54_PROMPT_CHAR_CAP=2400000
# MECHANISTIC_GPT4O_PROMPT_CHAR_CAP=30000
